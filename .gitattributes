# 3D models & Meshes
*.fbx filter=lfs diff=lfs merge=lfs -text
*.FBX filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.mesh filter=lfs diff=lfs merge=lfs -text

# Audio
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text

# Textures & Images
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
# Kept out of LFS (the LFS budget is spent): generated sky, Tools/Sky/build_sky.py.
Assets/Resources/Sky/**/*.jpg -filter binary
*.psd filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
# Kept out of LFS (the LFS budget is spent): generated road surface, Tools/Road.
Assets/Resources/Biomes/ForestRoad/**/*.jpg -filter binary
Assets/Resources/Biomes/ForestRoad/**/*.png -filter binary
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
# Kept out of LFS: the repository's LFS budget is exhausted, and these are small
# generated textures (Tools/Blender/build_forest_floor.py).
Assets/Resources/Biomes/ForestFloor/**/*.png -filter binary
*.cubemap filter=lfs diff=lfs merge=lfs -text

# Binary Assets & Packages
*.unitypackage filter=lfs diff=lfs merge=lfs -text

# Kept out of LFS: the repository's LFS budget is exhausted, and these are small
# generated assets (Tools/Blender/build_guardrail.py). Later rules override the
# *.png / *.fbx LFS rules above for this folder only.
Assets/Resources/Biomes/Guardrail/**/*.png -filter binary
Assets/Resources/Biomes/Guardrail/**/*.fbx -filter binary
# Baked road centreline (Tools/Terrain/build_b500_road.py): raw binary, no line-ending conversion.
Assets/Resources/Biomes/Routes/*.bytes binary
