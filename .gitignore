# Unity .gitignore
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Aa]ssets/[Aa]sset[Ss]tore[Tt]ools*

# Large unused raw packages (>10GB)
Assets/vrbn_studios/
Assets/vrbn_studios.meta
Assets/Gregor Quendel - Free General Ambience Sounds/
Assets/Gregor Quendel - Free General Ambience Sounds.meta
Assets/Versatile Studio Assets/Demo City By Versatile Studio/Scenes/demo_city_night/LightingData.asset
Assets/Versatile Studio Assets/Demo City By Versatile Studio/Scenes/demo_city_night/LightingData.asset.meta
# Baked lighting for the Traffic Lights System demo scene - regenerable, third-party demo.
Assets/Traffic Lights System/Demo/Scenes/DemoSettings.lighting
Assets/Traffic Lights System/Demo/Scenes/DemoSettings.lighting.meta

# Visual Studio / VS Code / JetBrains Rider
.vscode/
.vs/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# OS generated
.DS_Store
Thumbs.db

# graphify knowledge graph — regenerate with `graphify update .`
graphify-out/

# SymbolCheck (Tools/SymbolCheck). Its build output is generated, but its project
# file is source - the *.csproj rule above exists for Unity's generated
# Assembly-CSharp.csproj and would otherwise swallow this one, leaving the tool
# unbuildable on a fresh clone.
Tools/SymbolCheck/bin/
Tools/SymbolCheck/obj/
!Tools/SymbolCheck/SymbolCheck.csproj

# Python bytecode from the tools under Tools/
__pycache__/
*.pyc

# Asset Store packs are licensed for use, not redistribution: installed locally,
# never committed. Road Rage > Link Installed Tree Pack writes the registry below.
Assets/NatureManufacture Assets/
Assets/NatureManufacture Assets.meta
Assets/Resources/Biomes/ExternalVegetation.asset
Assets/Resources/Biomes/ExternalVegetation.asset.meta

# Asian Canal Environment (Leartes Studios, from Fab): licensed for use, not for
# redistribution. Exported from Unreal to FBX and kept only in the local project.
Assets/AsianCanal/
Assets/AsianCanal.meta
Assets/Resources/Biomes/AsianCanalPack.asset
Assets/Resources/Biomes/AsianCanalPack.asset.meta
